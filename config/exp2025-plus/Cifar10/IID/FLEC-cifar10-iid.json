{
  "wandb": {
    "enabled": true,
    "project": "Exp2025-V2-Cifar10",
    "name": "FLEC-iid-random"
  },
  "global": {
    "mode": {
      "path": "core.MPMT.MPMT"
    },
    "seed": 42,
    "dataset_pre_load": true,
    "use_file_system": false,
    "multi_gpu": true,
    "experiment": "Exp2025-V2-Cifar10-iid/FLEC-iid-random",
    "stale": false,
    "dataset": {
      "path": "dataset.CIFAR10.CIFAR10",
      "params": {}
    },
    "iid": true,
    "client_num": 100
  },
  "server": {
    "path": "server.SemiAsyncServer.SemiAsyncServer",
    "epochs": 2010,
    "model": {
      "path": "torchvision.models.resnet.resnet18",
      "params": {
        "num_classes": 10
      }
    },
    "scheduler": {
      "path": "scheduler.FLECSemiAsyncScheduler.FLECSemiAsyncScheduler",
      "schedule": {
        "path": "schedule.DualGroupSchedule.DualGroupSchedule",
        "params": {
          "c_ratio": 0.4,
          "min_join_clients_num": 10,
          "total_bandwidth": 50,
          "data_size": 42.7,
          "max_join_clients_num": 12,
          "target_kl_divergence": 0.05,
          "theta": 0.001,
          "init_select_clients_num": 8,
          "init_select_unique_clients_num": 5,
          "init_select_shared_clients_num": 3,
          "clients_edge_info_path": "/disk14T/ypguo/async-FL/src/FLEC_situation/clients_edge_info.csv",
          "delay_adaptive_optimizer": {
            "path": "algorithm.DelayAdaptiveOptimizer.DelayAdaptiveOptimizer",
            "params": {
              "total_bandwidth": 50,
              "data_size": 42.7,
              "noise_power": -104,
              "g_dB_coef": [
                -128.1,
                37.6
              ],
              "algorithm": "binary",
              "client_edge_info_path": "/disk14T/ypguo/async-FL/src/FLEC_situation/clients_edge_info.csv"
            }
          }
        }
      }
    },
    "updater": {
      "path": "updater.SemiAsyncUpdater.SemiAsyncUpdater",
      "update": {
        "path": "update.FedAvg.FedAvg",
        "params": {}
      },
      "loss": "torch.nn.functional.cross_entropy",
      "params": {},
      "group": {
        "path": "update.FLEC.FLEC",
        "params": {
          "alpha": 0.9,
          "v": 0.95,
          "staleness_threshold": 10
        }
      }
    }
  },
  "group_manager": {
    "path": "groupmanager.FLECGroupManager.FLECGroupManager",
    "group_method": {
      "path": "group.DualGroupPlus.DualGroupPlus",
      "params": {
        "situation_path": "/disk14T/ypguo/async-FL/src/FLEC_situation/clients_edge_info.csv",
        "edge_server_num": 5,
        "nearest_K": 20
      }
    }
  },
  "queue_manager": {
    "path": "queuemanager.QueueListManager.QueueListManager",
    "receiver": {
      "path": "receiver.MultiQueueReceiver.MultiQueueReceiver",
      "params": {}
    },
    "checker": {
      "path": "checker.AllChecker.AllChecker",
      "params": {}
    }
  },
  "client_manager": {
    "path": "clientmanager.MPMTClientManager.MPMTClientManager",
    "process_num": 10
  },
  "client": {
    "path": "client.FLEClient.FLEClient",
    "epochs": 5,
    "batch_size": 50,
    "model": {
      "path": "torchvision.models.resnet.resnet18",
      "params": {
        "num_classes": 10
      }
    },
    "transform": {
      "path": "transforms.Transforms.TransformForCIFARFactory.createTransform",
      "params": {}
    },
    "loss": "torch.nn.functional.cross_entropy",
    "mu": 0,
    "optimizer": {
      "path": "torch.optim.SGD",
      "params": {
        "lr": 0.05,
        "weight_decay": 0
      }
    }
  }
}