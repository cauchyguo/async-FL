{
  "wandb": {
    "enabled": true,
    "project": "Exp2025",
    "name": "fedavg-cifar10-baseline-test-transform"
  },
  "global": {
    "seed": 2025,
    "dataset_pre_load": true,
    "use_file_system": false,
    "multi_gpu": false,
    "experiment": "Exp2025/fedavg-cifar10-baseline",
    "custom": {
      "stale_generator": "stale.CustomStaleGenerator.CustomStaleGenerator",
      "clients_info_path": "/home/ypguo/async-FL/src/clients_info/clients_info_fedat.csv"
    },
    "stale": false,
    "dataset": {
      "path": "dataset.CIFAR10.CIFAR10",
      "params": {}
    },
    "iid": false,
    "client_num": 100
  },
  "server": {
    "path": "server.NormalServer.NormalServer",
    "epochs": 1000,
    "model": {
      "path": "torchvision.models.resnet.resnet18",
      "params": {
        "num_classes": 10
      }
    },
    "scheduler": {
      "path": "scheduler.SyncScheduler.SyncScheduler",
      "schedule": {
        "path": "schedule.RandomSchedule.RandomSchedule",
        "params": {
          "c_ratio": 0.1
        }
      }
    },
    "updater": {
      "path": "updater.SyncUpdater.SyncUpdater",
      "loss": "torch.nn.functional.cross_entropy",
      "update": {
        "path": "update.FedAvg.FedAvg",
        "params": {}
      }
    }
  },
  "queue_manager": {
    "path": "queuemanager.SingleQueueManager.SingleQueueManager",
    "receiver": {
      "path": "receiver.NormalReceiver.NormalReceiver",
      "params": {}
    },
    "checker": {
      "path": "checker.SyncChecker.SyncChecker",
      "params": {}
    }
  },
  "client_manager": {
    "path": "clientmanager.NormalClientManager.NormalClientManager"
  },
  "client": {
    "path": "client.NormalClient.NormalClient",
    "epochs": 2,
    "batch_size": 128,
    "test_size": 0.1,
    "test_batch_size": 128,
    "model": {
      "path": "torchvision.models.resnet.resnet18",
      "params": {
        "num_classes": 10
      }
    },
    "loss": "torch.nn.functional.cross_entropy",
    "transform": {
      "path": "transforms.Transforms.TransformForCIFARFactory.createTransform",
      "params": {}
    },
    "mu": 0,
    "optimizer": {
      "path": "torch.optim.SGD",
      "params": {
        "lr": 0.01,
        "weight_decay": 0
      }
    }
  }
}